# File này quyết định thứ KHÔNG được copy vào image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secret — tuyệt đối không nướng vào image
.env
.env.*
!.env.example

# Bytecode và cache Python
__pycache__
*.pyc
*.pyo
.pytest_cache

# Git và môi trường ảo local
.git
.gitignore
.venv
venv

# Linh tinh
screenshots
*.md
.DS_Store
